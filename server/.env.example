# ==============================================================================
# HiveMind Backend Environment Variables (.env)
# ==============================================================================

PORT=5000
NODE_ENV=production
CLIENT_URL=https://hivemindsist.dev
ALLOWED_ORIGINS=https://hivemindsist.dev,https://www.hivemindsist.dev

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/hivemind?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_production_super_secret_jwt_key_change_this

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=n348amus
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Zoho Mail SMTP Configuration (Use smtp.zoho.in for India datacenter, smtp.zoho.com for US)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=noreply@hivemindsist.dev
SMTP_PASS=your_zoho_app_password
EMAIL_FROM="HiveMind Team <noreply@hivemindsist.dev>"

# Notification Recipients
TEAM_LEADS_EMAILS=bersinmail@gmail.com, sherinsahaya0806@gmail.com, betsyjose09@gmail.com, keer.1705@gmail.com, antojeffrin007@gmail.com, naveenkumarsivarajan1925@gmail.com